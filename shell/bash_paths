#!/bin/bash

# bash_paths

# Put Homebrew on PATH first: the list below needs HOMEBREW_PREFIX, and the
# files sourced later need `brew`. Skip it when this shell already has it —
# `brew shellenv` runs path_helper, which rebuilds PATH from /etc/paths and
# would push the list below behind the Homebrew directories.
if [[ -z "$HOMEBREW_PREFIX" && -x /opt/homebrew/bin/brew ]]; then
    # Name the shell, or `brew shellenv` reads $SHELL and can emit the wrong
    # syntax.
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
fi

# Directories that must come before the system PATH, highest priority first.
# Use HOMEBREW_PREFIX from the step above instead of `brew --prefix`. Each call
# to `brew` starts a Ruby process and makes every new shell slower.
declare -a dirs=(
    "${HOME}/bin" # Personal scripts take priority over everything
    "${DOTFILES_DIRECTORY}/bin"
    "${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin" # GNU core utilities must beat the BSD ones in /usr/bin
    "${HOMEBREW_PREFIX}/share/npm/bin" # npm-installed package bin
)

# Build the new prefix in list order, then put it ahead of the current PATH.
# Do not prepend in the loop. That puts the last entry of the list first.
path_prefix=""
for dir in "${dirs[@]}"
do
    # Skip a directory that does not exist, or that PATH already holds. The
    # second test stops a re-sourced profile from making duplicate entries.
    if [[ -d "$dir" && ":${path_prefix}${PATH}:" != *":${dir}:"* ]]; then
        path_prefix="${path_prefix}${dir}:"
    fi
done

PATH="${path_prefix}${PATH}"

unset dirs dir path_prefix

export PATH
