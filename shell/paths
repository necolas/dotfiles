#!/bin/zsh

# paths
#
# The PATH policy. `zprofile` sources this for every login shell.
#
# Holds only the entries this repo owns. A tool that manages its own PATH writes
# to `~/.zshrc`, and a copy here would compete with it and go stale.

# Homebrew. Set the variables here. Do not use `brew shellenv`: it sets PATH
# through path_helper, which rebuilds PATH from /etc/paths and leaves /usr/bin
# ahead of /opt/homebrew/bin. Every login shell runs /etc/zprofile, so a nested
# login shell runs path_helper a second time and loses the Homebrew order.
if [[ -x /opt/homebrew/bin/brew ]]; then
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="${HOMEBREW_PREFIX}/Cellar"
    export HOMEBREW_REPOSITORY="${HOMEBREW_PREFIX}"

    # Add the info pages one time. A nested shell sources this file again.
    #
    # Test the string by hand. `typeset -U` deduplicates a colon-joined scalar
    # only when the name is tied to an array, and zsh ties only path, fpath,
    # cdpath, manpath, mailpath and module_path. There is no infopath.
    if [[ ":${INFOPATH}:" != *":${HOMEBREW_PREFIX}/share/info:"* ]]; then
        export INFOPATH="${HOMEBREW_PREFIX}/share/info${INFOPATH:+:${INFOPATH}}"
    fi

    # The Homebrew completion directory goes on fpath in `shell/completion`. This
    # file runs from zprofile, which only a login shell reads, and fpath is not
    # inherited, so an entry made here is missing in every nested shell.
fi

# Directories that must come before the system PATH, highest priority first.
typeset -a dirs=(
    "${HOME}/bin" # Personal scripts take priority over everything
    "${DOTFILES_DIRECTORY}/bin"
    "${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin" # GNU core utilities must beat the BSD ones in /usr/bin
    "${HOMEBREW_PREFIX}/bin"
    "${HOMEBREW_PREFIX}/sbin"
    "${HOMEBREW_PREFIX}/share/npm/bin" # npm-installed package bin
)

# Keep the ones that exist, in list order.
typeset -a wanted=()
for dir in "${dirs[@]}"
do
    [[ -d "$dir" ]] && wanted+=("$dir")
done

# Prepend the whole list in one assignment.
#
# `zshenv` sets `typeset -U PATH path`, and zsh reads zshenv before zprofile, so
# the attribute is already active. A unique array keeps the first copy of each
# entry, so an entry that path_helper left further down PATH moves to the front
# and the later copy disappears.
path=($wanted $path)
export PATH

unset dirs dir wanted
